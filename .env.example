# Copy to .env and fill in. .env holds secrets: never commit or share it.

# Tag of the tadiewa/vehicle-workflow-be and -fe images (bump per release)
IMAGE_TAG=uat-1

# Where the frontend project is, relative to this folder (only needed on the PC that builds the images)
FRONTEND_DIR=../../vehicle workflowFE/vehicleworkflow

# The app is served at https://SERVER_HOST:WEB_PORT (443 is taken by the coupon system)
SERVER_HOST=test.petrotrade.co.zw
# Every address people open the app on. Browsers send it with each save, and the API refuses others
CORS_ALLOWED_ORIGINS=https://196.43.101.217:8099,https://test.petrotrade.co.zw:8099
WEB_PORT=8099

# PostgreSQL (its own container; only reachable from the server itself on 127.0.0.1:DB_HOST_PORT)
DB_NAME=vehiclefuelworkflow
DB_USERNAME=postgres
DB_PASSWORD=
DB_HOST_PORT=5435

# Shared help desk Keycloak (logbook stack)
KEYCLOAK_REALM=helpdesk
# Keycloak as the browser reaches it. Must match the logbook stack's KC_HOSTNAME_URL exactly
# (logbook pins it to its SERVER_HOST, the IP), because tokens are issued for that address.
KEYCLOAK_PUBLIC_URL=https://196.43.101.217:8198
# Docker network of the logbook stack and Keycloak's address on it
KEYCLOAK_NETWORK=helpdesk_default
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# Filled in by the Keycloak setup step in DEPLOY.md
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Email (Office 365, same as the help desk). Blank = no emails are sent; the app still works.
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
HR_MANAGER_EMAIL=
IT_DEPARTMENT_EMAIL=
